#!/bin/busybox sh
# /init of a mkdebinitrd image: mount the API filesystems, generate an
# inittab for the kernel's active consoles, then exec busybox init (PID 1).
#
# Kernel command line options:
#   bbinit.autologin=yes|no   root shell on consoles vs. login prompt
#   bbinit.network=yes|no     run DHCP on all physical NICs
#   bbinit.shell              drop to a busybox shell before init (debugging)

bb=/usr/bin/busybox
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

$bb mount -t proc -o nosuid,nodev,noexec proc /proc
$bb mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
$bb mount -t devtmpfs -o mode=0755,nosuid devtmpfs /dev
$bb mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run
$bb mkdir -p /run/busybox-init /run/lock

. /etc/busybox-init/settings
for arg in $($bb cat /proc/cmdline); do
	case "$arg" in
	bbinit.autologin=*) BBINIT_AUTOLOGIN=${arg#*=} ;;
	bbinit.network=*) BBINIT_NETWORK=${arg#*=} ;;
	bbinit.shell) BBINIT_SHELL=yes ;;
	esac
done
$bb cat > /run/busybox-init/env <<ENV
BBINIT_AUTOLOGIN=$BBINIT_AUTOLOGIN
BBINIT_NETWORK=$BBINIT_NETWORK
ENV

if [ "$BBINIT_SHELL" = yes ]; then
	echo "bbinit.shell: exit the shell to continue booting"
	$bb setsid $bb cttyhack $bb sh
fi

# One console entry per active kernel console (console= on the cmdline).
consoles=$($bb cat /sys/class/tty/console/active 2>/dev/null)
[ -n "$consoles" ] || consoles=tty1
{
	echo "# Generated by /init at boot; edit /init or /etc/busybox-init/ instead."
	echo "::sysinit:/etc/busybox-init/rcS"
	for c in $consoles; do
		[ "$c" = tty0 ] && c=tty1
		case "$c" in tty[0-9]*) term=linux ;; *) term=vt102 ;; esac
		if [ "$BBINIT_AUTOLOGIN" = yes ]; then
			echo "$c::respawn:$bb login -f root"
		else
			echo "::respawn:$bb getty -L 0 $c $term"
		fi
	done
	echo "::ctrlaltdel:$bb reboot"
	echo "::shutdown:/etc/busybox-init/rcK"
	echo "::restart:$bb init"
} > /etc/inittab

exec $bb init
