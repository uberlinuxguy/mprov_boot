#!/bin/busybox sh
# udhcpc event handler: configure the interface, default route and DNS.
bb=/usr/bin/busybox
RESOLV=/etc/resolv.conf

case "$1" in
deconfig)
	$bb ip -4 addr flush dev "$interface"
	$bb ip link set "$interface" up
	;;
bound|renew)
	$bb ip -4 addr flush dev "$interface"
	$bb ip addr add "$ip/${mask:-24}" ${broadcast:+broadcast $broadcast} dev "$interface"
	[ -n "$mtu" ] && $bb ip link set "$interface" mtu "$mtu"
	if [ -n "$router" ]; then
		while $bb ip -4 route del default dev "$interface" 2>/dev/null; do :; done
		metric=0
		for r in $router; do
			$bb ip route add default via "$r" dev "$interface" metric $metric
			metric=$((metric + 1))
		done
	fi
	{
		[ -n "$domain" ] && echo "search $domain"
		for s in $dns; do echo "nameserver $s"; done
	} > "$RESOLV.$interface"
	# Last interface to get a lease with DNS servers wins.
	[ -s "$RESOLV.$interface" ] && $bb cat "$RESOLV.$interface" > "$RESOLV"
	;;
leasefail|nak)
	;;
esac
exit 0
