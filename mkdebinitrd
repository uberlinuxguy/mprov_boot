def fetch(url, dest=None):
    """Download url; return bytes, or write to dest and return None."""
    debug("GET " + url)
    req = urllib.request.Request(url, headers={"User-Agent": "mkdebinitrd/1.0"})
    with urllib.request.urlopen(req, timeout=120) as resp:
        if dest is None:
            return resp.read()
        tmp = dest + ".part"
        with open(tmp, "wb") as f:
            shutil.copyfileobj(resp, f, 1 << 20)
        os.replace(tmp, dest)
    return None


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def parse_deb822(text):
    """Parse RFC822-style stanzas (Packages, Release, control files)."""
    stanzas = []
    cur = {}
    key = None
    for line in text.splitlines():
        if not line.strip():
            if cur:
                stanzas.append(cur)
            cur, key = {}, None
        elif line[0] in " \t":
            if key is not None:
                cur[key] += "\n" + line
        else:
            key, _, val = line.partition(":")
            cur[key] = val.strip()
    if cur:
        stanzas.append(cur)
    return stanzas


def strip_pgp(text):
    """Return the signed payload of a clear-signed InRelease file."""
    if not text.startswith("-----BEGIN PGP SIGNED MESSAGE-----"):
        return text
    body = text.split("\n\n", 1)[1]
    body = body.split("\n-----BEGIN PGP SIGNATURE-----", 1)[0]
    return "\n".join(l[2:] if l.startswith("- ") else l for l in body.splitlines())


class Repo:
    def __init__(self, mirror, suite, arch, components, keyring, workdir):
        self.mirror = mirror.rstrip("/")
        self.suite = suite
        self.arch = arch
        self.components = components
        self.keyring = keyring
        self.workdir = workdir
        self.packages = {}      # name -> stanza
        self.providers = {}     # virtual name -> [real names]
        self.codename = suite

    def load(self):
        base = "%s/dists/%s" % (self.mirror, self.suite)
        inrelease = os.path.join(self.workdir, "InRelease." + self.arch)
        fetch(base + "/InRelease", inrelease)
        if self.keyring:
            try:
                run(["gpgv", "--keyring", self.keyring, inrelease],
                    stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            except FileNotFoundError:
                die("gpgv not found but --keyring was given")
            except subprocess.CalledProcessError as e:
                die("InRelease signature check failed:\n" + e.stderr.decode(errors="replace"))
            log("InRelease signature verified with " + self.keyring)
        else:
            log("warning: no keyring; InRelease signature NOT verified "
                "(relying on transport security of %s)" % self.mirror)
        with open(inrelease, encoding="utf-8") as f:
            release = parse_deb822(strip_pgp(f.read()))[0]
        self.codename = release.get("Codename", self.suite)
        archs = release.get("Architectures", "").split()
        if archs and self.arch not in archs:
            die("architecture %s not in %s (available: %s)" % (self.arch, self.suite, " ".join(archs)))

        sums = {}
        for line in release.get("SHA256", "").splitlines():
            parts = line.split()
            if len(parts) == 3:
                sums[parts[2]] = parts[0]

        for comp in self.components:
            got = False
            for ext, opener in ((".xz", lzma.decompress), (".gz", gzip.decompress)):
                rel = "%s/binary-%s/Packages%s" % (comp, self.arch, ext)
                if rel not in sums:
                    continue
                data = fetch("%s/%s" % (base, rel))
                if hashlib.sha256(data).hexdigest() != sums[rel]:
                    die("checksum mismatch for " + rel)
                self._add_index(opener(data).decode("utf-8"))
                got = True
                break
            if not got:
                die("no Packages index for component %s/%s" % (comp, self.arch))
        log("loaded %d packages from %s (%s) [%s]"
            % (len(self.packages), self.suite, self.codename, ",".join(self.components)))

    def _add_index(self, text):
        for p in parse_deb822(text):
            name = p.get("Package")
            if not name:
                continue
            self.packages[name] = p
            for prov in split_deps(p.get("Provides", "")):
                for alt in prov:
                    self.providers.setdefault(alt, []).append(name)


def split_deps(field):
    """'a (>= 1) | b:any, c [amd64]' -> [['a', 'b'], ['c']] (versions ignored)."""
    out = []
    for clause in field.split(","):
        clause = clause.strip()
        if not clause:
            continue
        alts = []
        for alt in clause.split("|"):
            alt = re.sub(r"\(.*?\)|\[.*?\]|<.*?>", "", alt).strip()
            alt = alt.split(":")[0]
            if alt:
                alts.append(alt)
        if alts:
            out.append(alts)
    return out


PRIORITY_RANK = {"required": 0, "important": 1, "standard": 2, "optional": 3, "extra": 4}


def resolve(repo, wanted, excluded):
    """Close `wanted` over Depends/Pre-Depends.  Returns names in discovery order."""
    selected = []
    seen = set()
    # Everything explicitly wanted counts as chosen from the start, so an
    # alternative or virtual (e.g. "awk") resolves to it (mawk) when possible.
    planned = {n for n in wanted if n in repo.packages}

    def providers(name):
        return sorted((p for p in repo.providers.get(name, []) if p not in excluded),
                      key=lambda p: PRIORITY_RANK.get(repo.packages[p].get("Priority"), 9))

    def pick(alts):
        # Prefer something already chosen, then a real package, then a provider.
        for a in alts:
            for cand in [a] + repo.providers.get(a, []):
                if cand in seen or cand in planned:
                    return cand
        for a in alts:
            if a in repo.packages and a not in excluded:
                return a
        for a in alts:
            for prov in providers(a):
                return prov
        return None

    queue = list(wanted)
    while queue:
        name = queue.pop(0)
        if name in seen:
            continue
        if name not in repo.packages:
            prov = pick([name])
            if prov is None:
                die("package not found: " + name)
            name = prov
            if name in seen:
                continue
        seen.add(name)
        selected.append(name)
        p = repo.packages[name]
        for clause in split_deps(p.get("Pre-Depends", "")) + split_deps(p.get("Depends", "")):
            choice = pick(clause)
            if choice is None:
                log("warning: unsatisfiable dependency of %s: %s" % (name, " | ".join(clause)))
            elif choice not in seen:
                queue.append(choice)
    return selected


def download_all(repo, names, cachedir, jobs):
    """Fetch .debs into cachedir (verified by SHA256).  Returns name -> path."""
    os.makedirs(cachedir, exist_ok=True)
    paths = {}
    todo = []
    for n in names:
        p = repo.packages[n]
        path = os.path.join(cachedir, os.path.basename(p["Filename"]))
        paths[n] = path
        if not (os.path.exists(path) and sha256_file(path) == p["SHA256"]):
            todo.append((n, p, path))
    total = sum(int(p.get("Size", 0)) for _, p, _ in todo)
    log("downloading %d of %d packages (%.1f MiB)" % (len(todo), len(names), total / 2**20))

    def one(item):
        n, p, path = item
        for attempt in range(3):
            try:
                fetch("%s/%s" % (repo.mirror, p["Filename"]), path)
                if sha256_file(path) == p["SHA256"]:
                    return
                log("checksum mismatch for %s, retrying" % n)
            except Exception as e:  # network hiccups: retry
                log("download of %s failed (%s), retrying" % (n, e))
        die("could not download " + n)

    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as ex:
        list(ex.map(one, todo))
    return paths


