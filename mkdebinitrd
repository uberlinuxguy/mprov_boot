# .deb handling
# --------------------------------------------------------------------------

def ar_members(path):
    """Yield (name, bytes) for each member of an ar archive (.deb)."""
    with open(path, "rb") as f:
        if f.read(8) != b"!<arch>\n":
            die("not a deb (bad ar magic): " + path)
        while True:
            hdr = f.read(60)
            if len(hdr) < 60:
                return
            name = hdr[0:16].decode().strip().rstrip("/")
            size = int(hdr[48:58].decode().strip())
            data = f.read(size)
            if size % 2:
                f.read(1)
            yield name, data


class Deb:
    def __init__(self, path):
        self.path = path
        self.control_tar = None
        self.data_tar = None
        for name, data in ar_members(path):
            if name.startswith("control.tar"):
                self.control_tar = (name, data)
            elif name.startswith("data.tar"):
                self.data_tar = (name, data)
        if not self.control_tar or not self.data_tar:
            die("malformed deb: " + path)

    def _tar(self, member, args, tmpdir, **kw):
        name, data = member
        tmp = os.path.join(tmpdir, name)
        with open(tmp, "wb") as f:
            f.write(data)
        try:
            return run(["tar"] + args + ["-f", tmp], **kw)
        finally:
            os.unlink(tmp)

    def extract_data(self, root, tmpdir, members=()):
        # --keep-directory-symlink: don't replace the merged-/usr symlinks.
        self._tar(self.data_tar, ["-x", "--keep-directory-symlink", "--numeric-owner",
                                  "-p", "-C", root] + list(members), tmpdir)

    def list_data(self, tmpdir):
        out = self._tar(self.data_tar, ["-t"], tmpdir, stdout=subprocess.PIPE).stdout
        return out.decode("utf-8", "surrogateescape").splitlines()

    def extract_control(self, dest, tmpdir):
        os.makedirs(dest, exist_ok=True)
        self._tar(self.control_tar, ["-x", "-C", dest], tmpdir)


